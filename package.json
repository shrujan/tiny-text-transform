{
  "name": "tiny-text-transform",
  "version": "1.0.6",
  "description": "A simple plugin to transform the text.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch",
    "test": "echo \"No tests yet\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrujan/tiny-text-transform.git"
  },
  "keywords": [
    "text",
    "transform",
    "string",
    "typescript",
    "utility",
    "formatter",
    "pascal case",
    "kebab case",
    "snake case",
    "title case"
  ],
  "author": "shrujan shetty",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/shrujan/tiny-text-transform/issues"
  },
  "homepage": "https://github.com/shrujan/tiny-text-transform#readme",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
